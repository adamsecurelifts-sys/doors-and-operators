NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=doors_wholesale
